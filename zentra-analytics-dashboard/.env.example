# Local development defaults
# The backend can move to the next free port (for example 3006+ if 3002-3005 are occupied).
# The frontend will automatically try the active local ports, so this is only a fallback.
VITE_API_BASE_URL="http://localhost:3006"
APP_URL="http://localhost:3000"

# Production overrides
# VITE_API_BASE_URL="https://erp.faizal.uk"
# APP_URL="https://erp.faizal.uk"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
