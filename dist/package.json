{
  "name": "macos-website-api",
  "version": "1.0.0",
  "description": "API for MacOS website - handles wallpaper management",
  "main": "API/server.js",
  "scripts": {
    "start": "node backend/main/macos-api-server.js",
    "api": "nodemon backend/main/macos-api-server.js",
    "backend": "cross-env PORT=3002 node backend/main/macos-api-server.js",
    "dev": "vite --host localhost --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "ipv6:update": "powershell -ExecutionPolicy Bypass -File \"scripts/ipv6-updater.ps1\"",
    "dev:local": "concurrently \"npm run backend\" \"npm run dev\"",
    "diagnose": "node src/api/main/diagnose-connectivity.js",
    "migrate:ledger:preview": "node backend/core/db/migrate-ledger.js --dry-run",
    "migrate:ledger": "node backend/core/db/migrate-ledger.js",
    "dev:oraclevm": "cross-env NODE_ENV=oraclevm PORT=3003 node backend/main/macos-api-server.js",
    "pm2:start:prod": "pm2 start ecosystem.config.js --env production",
    "pm2:start:vm": "pm2 start ecosystem.config.js --env oraclevm",
    "pm2:stop": "pm2 stop ecosystem.config.js || true",
    "check:dev": "node tools/healthcheck.mjs dev",
    "check:prod": "node tools/healthcheck.mjs prod",
    "test:account-flow": "node backend/scripts/test-account-flow-contracts.js",
    "android:update:publish": "powershell -ExecutionPolicy Bypass -File ./scripts/publish-android-update.ps1"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@simplewebauthn/server": "^13.3.3",
    "archiver": "^7.0.1",
    "axios": "^1.13.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "body-parser": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "http-proxy": "^1.18.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.1",
    "pdfkit": "^0.17.2",
    "puppeteer": "^25.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "nodemon": "^3.0.2",
    "postcss": "^8.5.8",
    "sqlite3": "^5.0.2",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.0",
    "vite-plugin-static-copy": "^3.2.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
